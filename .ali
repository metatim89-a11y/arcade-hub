# Arcade Hub project-scoped aliases.
# This file is sourced by .project/termux.sh after PROJECT_ROOT is set.

project_alias arcade-help 'bash "$PROJECT_ROOT/custom.sh" help'
project_alias start 'bash "$PROJECT_ROOT/custom.sh" start'
project_alias build 'bash "$PROJECT_ROOT/custom.sh" build'
project_alias preview 'bash "$PROJECT_ROOT/custom.sh" preview'
project_alias install 'bash "$PROJECT_ROOT/custom.sh" install'
project_alias repo-check 'bash "$PROJECT_ROOT/custom.sh" repo-check'
project_alias repo-status 'bash "$PROJECT_ROOT/custom.sh" repo-status'
project_alias repo-diff 'bash "$PROJECT_ROOT/custom.sh" repo-diff'
